;; Q: CPU use of the poll loop when idle, and is the window usable while it runs?
(setq *i* 0)
(log-kv "ready" T)
(while (not (findfile (strcat *dir* "quit.flag")))
  (setq *f* (open (strcat *dir* "heartbeat") "w"))
  (write-line (rtos (getvar "CDATE") 2 6) *f*)
  (close *f*)
  (findfile (strcat *dir* "cmd.lsp"))
  (command "_.DELAY" 250)
  (setq *i* (1+ *i*))
)
(log-kv "iterations" *i*)
(log-kv "final-state" (state))
(finish)
