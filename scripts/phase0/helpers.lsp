;; Q: which helper forms work for bounding boxes, files and JSON values?
(setq *line* (add-line))
(safe "vle-getboundingbox" (function (lambda () (vle-getboundingbox *line*))))
(safe "vle-getgeomextents" (function (lambda () (vle-getgeomextents *line*))))
(safe "vla-getboundingbox" (function (lambda (/ a b)
  (vla-getboundingbox (vlax-ename->vla-object *line*) 'a 'b)
  (list (vlax-safearray->list a) (vlax-safearray->list b)))))
(safe "vle-file->list" (function (lambda () (vle-file->list (strcat *here* "unicode_input.txt")))))
(safe "vl-directory-files" (function (lambda () (vl-directory-files *here* "*.txt" 1))))
(safe "vl-file-systime" (function (lambda () (vl-file-systime (strcat *here* "unicode_input.txt")))))
(safe "vl-file-rename-over-existing" (function (lambda (/ a b f)
  (setq a (strcat *dir* "a.tmp") b (strcat *dir* "b.tmp"))
  (setq f (open a "w")) (write-line "new" f) (close f)
  (setq f (open b "w")) (write-line "old" f) (close f)
  (vl-file-rename a b))))
(safe "ssget-empty-filter" (function (lambda () (ssget "_X" '((0 . "NO_SUCH_TYPE"))))))
(safe "dbmod-readonly" (function (lambda () (getvar "DBMOD"))))
(safe "insunits" (function (lambda () (getvar "INSUNITS"))))
(safe "extmin" (function (lambda () (list (getvar "EXTMIN") (getvar "EXTMAX")))))
(safe "layoutlist" (function (lambda () (layoutlist))))
(safe "ctab" (function (lambda () (getvar "CTAB"))))
(safe "number-forms" (function (lambda () (list (rtos 1.5 2 15) (rtos 1e12 2 15) (vl-prin1-to-string 1.5)))))
(finish)
